# بایگانی: فایل‌ها فقط برای کاربرِ واردشده (پنل یا پنلِ شرکت‌ها) از طریقِ _guard.php فرستاده می‌شوند؛ هیچ اسکریپتی اجرا نمی‌شود (سپرِ امنیتی)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_URI} !_guard\.php$
    RewriteRule ^ _guard.php [L]
</IfModule>
<FilesMatch "(?i)^(?!_guard\.php$).*\.(php\d?|phtml|phar|pht|phps|pgif|cgi|pl|py|sh|asp|aspx|jsp|shtml|htaccess|htpasswd|ini)(\.|$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
Options -Indexes
