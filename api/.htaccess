# فایل‌های کتابخانه‌ای (با «_» شروع می‌شوند) فقط با require در خودِ برنامه استفاده می‌شوند و از بیرون باز نمی‌شوند (سپرِ امنیتی)
<FilesMatch "^(_.*|finance_core|premium_calc)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
Options -Indexes
