# تنظیمات حساس محلی
config/db.local.php

# فایل‌های لاگ
*.log

# پوشه‌های موقت/رانتایم پردازش OCR و رسید و بایگانی
# (فقط ساختار پوشه با .gitkeep نگه داشته می‌شود، محتوای واقعی وارد گیت نمی‌شود)
tmp_ocr/*
!tmp_ocr/.gitkeep

tmp_recon/*
!tmp_recon/.gitkeep

tmpl_invoice/*
!tmpl_invoice/.gitkeep

queue/pending/*
!queue/pending/.gitkeep

queue/done/*
!queue/done/.gitkeep

queue/attachments/*
!queue/attachments/.gitkeep

queue/case_uploads/*
!queue/case_uploads/.gitkeep

موقت/موقت بایگانی/*
!موقت/موقت بایگانی/.gitkeep

Archive/بایگانی/بایگانی صادره/*
!Archive/بایگانی/بایگانی صادره/.gitkeep

Archive/بایگانی/بایگانی کسر از حقوق/*
!Archive/بایگانی/بایگانی کسر از حقوق/.gitkeep

# فایل‌های سیستمی
.DS_Store
Thumbs.db

# کش پایتون
__pycache__/
*.pyc

# گزارش بازدید: فایل‌هایی که روی هاست ساخته/آپلود می‌شوند
report_assets/fonts/*
!report_assets/fonts/.gitkeep
report_assets/layouts/*
!report_assets/layouts/.gitkeep
report_assets/templates/cat*_*.docx
report_assets/templates/*(old*
report_assets/parsers/*(old*
Archive/بایگانی/بایگانی گزارشات بازدید/

# پشتیبان‌ها (روی هاست ساخته می‌شوند؛ شامل اطلاعات واقعی)
backup/

# عکس‌های پروفایلِ کاربران (روی هاست بارگذاری می‌شوند)
uploads/avatars/*
!uploads/avatars/.htaccess

# ردِ حافظه‌ی ساختِ گزارش بازدید (روی هاست ساخته می‌شود)
report_assets/logs/

# محافظِ پوشه‌ها (سپرِ امنیتی) باید داخلِ گیت بماند
!tmp_ocr/.htaccess
!tmp_recon/.htaccess
!tmpl_invoice/.htaccess

# بایگانیِ بیمه عمر (روی هاست ساخته می‌شود؛ اطلاعاتِ واقعیِ مشتری)
Archive/بایگانی/بایگانی بیمه عمر/
