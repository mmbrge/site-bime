# صفحه‌های مینی‌اپ (HTML) هرگز در WebViewِ بله کش نشوند تا نسخه‌ی تازه همیشه برسد؛ JS/CSS با ?v= تازه می‌شوند
<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
