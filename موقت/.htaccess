# فایل‌های آپلودی: هیچ اسکریپتی در این پوشه اجرا نشود و فهرستِ فایل‌ها نمایش داده نشود (سپرِ امنیتی)
<FilesMatch "(?i)\.(php\d?|phtml|phar|pht|phps|pgif|cgi|pl|py|sh|asp|aspx|jsp|shtml|htaccess|htpasswd|ini)(\.|$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pht
    RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pht
</IfModule>
Options -Indexes
