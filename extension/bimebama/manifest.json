{
  "manifest_version": 3,
  "name": "دستیار بیمه باما (اقساط + درگاه آتی)",
  "version": "5.0.0",
  "description": "ثبت خودکار نقدی و اقساط در سامانه پاسارگاد و درگاه هوشمند سامانه‌های بیمه ایران؛ ورود و تنظیمات از پنل بیمه باما",
  "key": "",
  "permissions": ["storage", "alarms", "notifications", "scripting", "activeTab", "proxy", "management"],
  "host_permissions": [
    "*://*.pasargadinsurance.ir/*",
    "http://127.0.0.1:8765/*",
    "__BB_SERVER_PATTERN__"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "دستیار بیمه باما",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "content_scripts": [
    { "matches": ["*://*.pasargadinsurance.ir/*"], "all_frames": true, "js": ["content.js"], "run_at": "document_end" }
  ],
  "web_accessible_resources": [
    { "resources": ["fonts/*.woff2"], "matches": ["*://*.pasargadinsurance.ir/*"] }
  ],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
